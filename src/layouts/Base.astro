---
import '../styles/tokens.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { SITIO } from '../config/sitio';
import { ruta, rutaRecurso } from '../lib/url';
import Icono from '../components/Icono.astro';
import versiones from '../../public/biblia/versiones.json';

interface Props {
  titulo: string;
  descripcion?: string;
  noindex?: boolean;
  canonical?: string;
  embed?: boolean;           // página /embed/: sin cabecera, sin pie, sin anuncios
  imagen?: string;           // portada del recurso (ruta dentro de public/): vista previa al compartir
  inicio?: boolean;          // portada: el buscador principal está en la página, no en la cabecera (celular)
}
const { titulo, descripcion = SITIO.descripcion, noindex = false, canonical, embed = false, imagen, inicio = false } = Astro.props;
// Pie: enlaces a los recursos publicados, leídos del catálogo (no se escriben a mano)
const publicados = embed ? [] : (await getCollection('recursos', (r) => r.data.publicado)).sort((a, b) => a.data.orden - b.data.orden);
const porEnfoque = (e: string, n: number) => publicados.filter((r) => r.data.enfoque === e).slice(0, n);
const PIE = [
  { titulo: 'Estudios de libro', items: porEnfoque('estudio-libro', 6) },
  { titulo: 'Herramientas de estudio', items: porEnfoque('herramientas-estudio', 6) },
];
// Navegación principal: cada enlace abre la portada con un filtro, o un recurso
const interlineales = publicados.filter((r) => r.id === 'interlineal-hebreo' || r.id === 'interlineal-griego');
// Con un solo interlineal, el enlace lo abre; con los dos (desde la v2.57), la portada los muestra juntos
const hrefInterlineal = interlineales.length === 1 ? rutaRecurso(interlineales[0].id) : ruta('?q=interlineal');
const NAV = [
  { t: 'Estudios interactivos', href: ruta(), activo: inicio },
  ...(interlineales.length ? [{ t: 'Interlineal', href: hrefInterlineal, activo: false }] : []),
  { t: 'Teología', href: ruta('?enfoque=teologia-sistematica'), activo: false },
  { t: 'Historia y mapas', href: ruta('?enfoque=historia-geografia'), activo: false },
  { t: 'Herramientas', href: ruta('?enfoque=herramientas-estudio'), activo: false },
];
// Para compartir se usa la versión JPG: WhatsApp y otras apps no siempre muestran WebP
const imagenAbsoluta = imagen ? new URL(ruta(imagen.replace(/\.webp$/, '.jpg')), Astro.site).href : undefined;
const tituloCompleto = titulo === SITIO.nombre ? titulo : `${titulo} · ${SITIO.nombre}`;
const urlCanonica = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang={SITIO.idioma} class={embed ? 'embed' : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={urlCanonica} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={urlCanonica} />
  {imagenAbsoluta && <meta property="og:image" content={imagenAbsoluta} />}
  {imagenAbsoluta && <meta property="og:image:width" content="1200" />}
  {imagenAbsoluta && <meta property="og:image:height" content="675" />}
  <meta name="twitter:card" content={imagenAbsoluta ? 'summary_large_image' : 'summary'} />
  <meta name="theme-color" content="#fafaf8" />
  <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>${SITIO.emoji}</text></svg>`)}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  {SITIO.analitica.goatcounter && (
    <script is:inline async data-goatcounter={SITIO.analitica.goatcounter} src="//gc.zgo.at/count.js"></script>
  )}
  <slot name="head" />
</head>
<body>
  {!embed && (
    <header class:list={['top', 'no-citas', { 'top-inicio': inicio }]}>
      <div class="top-izq">
        <a class="brand" href={ruta()}>
          <span class="brand-marca" aria-hidden="true">
            {SITIO.logo ? <img src={ruta(SITIO.logo)} alt="" width="44" height="44" /> : SITIO.emoji}
          </span>
          <span class="brand-nombre">{SITIO.nombre}</span>
        </a>
        <nav class="nav-principal" aria-label="Principal">
          {NAV.map((n) => <a href={n.href} aria-current={n.activo ? 'page' : undefined} data-nav>{n.t}</a>)}
        </nav>
      </div>
      <div class="top-der">
        <label class="version-biblia" title="Versión de la Biblia para las citas">
          <Icono n="libro" />
          <span class="version-etiqueta" aria-hidden="true">Versión:</span>
          <span class="visually-hidden">Versión de la Biblia</span>
          <select data-version-biblia>
            {versiones.map(v => <option value={v.id} selected={v.defecto}>{v.abrev}</option>)}
          </select>
        </label>
        {!inicio && (
          <form class="buscador" role="search" action={ruta()} data-buscador>
            <label for="q" class="visually-hidden">Buscar un recurso</label>
            <Icono n="buscar" />
            <input id="q" name="q" type="search" autocomplete="off" enterkeyhint="search"
              placeholder="Buscar estudio, mapa, tema…" />
            <kbd aria-hidden="true">/</kbd>
          </form>
        )}
        <a class="mis-guardados" href={ruta('?guardados=1')} data-guardados-enlace title="Los recursos que guardaste en este dispositivo">
          <Icono n="guardar" /><span>Mis guardados</span>
        </a>
      </div>
    </header>
  )}
  <slot />
  {!embed && (
    <footer class="pie">
      <div class="pie-columnas">
        <div class="pie-marca">
          <a class="pie-nombre" href={ruta()}><span aria-hidden="true">{SITIO.emoji}</span> {SITIO.nombre}</a>
          <p>Mapas, modelos 3D, líneas de tiempo y rutas de estudio interactivas para profundizar en la Biblia. Un recurso de la iglesia, gratuito, sin anuncios y sin cuentas.</p>
        </div>
        {PIE.map((c) => (
          <div>
            <h2>{c.titulo}</h2>
            <ul>{c.items.map((r) => <li><a href={rutaRecurso(r.id)}>{r.data.titulo}</a></li>)}</ul>
          </div>
        ))}
        <div>
          <h2>El sitio</h2>
          <ul>
            <li><a href={ruta()}>Catálogo completo</a></li>
            <li><a href={ruta('?guardados=1')}>Mis guardados</a></li>
            <li><a href={ruta('buzon/')}>Sugerir un recurso o reportar un error</a></li>
            <li><a href={ruta('privacidad/')}>Privacidad</a></li>
          </ul>
        </div>
      </div>
      <div class="pie-legal">
        <span>© {new Date().getFullYear()} {SITIO.nombre}. Proyecto de la iglesia, sin fines comerciales.</span>
        <span>Citas bíblicas: {versiones.find((v) => v.defecto)?.credito}</span>
      </div>
    </footer>
  )}
  {!embed && (
    <script>
      import { iniciarAnuncios } from '../lib/anuncios';
      iniciarAnuncios();
    </script>
  )}
  {!embed && (
    <script>
      // Versión de la Biblia: la misma preferencia que usa la burbuja de citas en las apps (citas.js)
      import { almacen } from '../lib/storage';
      const sel = document.querySelector<HTMLSelectElement>('[data-version-biblia]');
      if (sel) {
        const actual = almacen.versionBiblia();
        if (actual && [...sel.options].some(o => o.value === actual)) sel.value = actual;
        sel.addEventListener('change', () => {
          almacen.cambiarVersionBiblia(sel.value);
          // citas.js de esta página escucha este evento; las apps en iframe reciben el evento «storage»
          (window as any).Citas?.cambiarVersion?.(sel.value);
        });
        window.addEventListener('citas:version', e => { sel.value = (e as CustomEvent).detail; });
      }
      // «/» lleva al buscador (en la portada, al buscador principal)
      document.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement;
        if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable) return;
        const campo = document.querySelector<HTMLInputElement>('[data-consola] input[type=search]') ?? document.querySelector<HTMLInputElement>('[data-buscador] input');
        if (campo && campo.offsetParent !== null) { e.preventDefault(); campo.focus(); campo.select(); }
      });
    </script>
  )}
  {/* Citas bíblicas en burbuja también en las fichas y páginas del sitio (DIRECTRICES §15) */}
  <script is:inline define:vars={{ biblia: ruta('biblia/') }}>window.CITAS_BIBLIA = biblia;</script>
  <script is:inline src={ruta('apps/assets/js/citas.js')} defer></script>
</body>
</html>
